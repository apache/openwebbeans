<arquillian xmlns="http://jboss.org/schema/arquillian"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://jboss.org/schema/arquillian http://jboss.org/schema/arquillian/arquillian_1_0.xsd">

    <container qualifier="se-container" default="true">
        <configuration>
            <!--
                Every jar in this directory ends up on the classpath of the JVM that the SE
                container forks per deployment. maven-dependency-plugin fills it during
                process-test-resources, see pom.xml.

                Filtered in from ${owb.se.tck.librariesPath} so the staging directory is defined in
                exactly one place; this file is only ever used from the build.
            -->
            <property name="librariesPath">${owb.se.tck.librariesPath}</property>
            <!-- seconds to wait for the forked JVM to boot OWB and register its JMX test runner -->
            <property name="waitTime">60</property>
        </configuration>
    </container>

</arquillian>
